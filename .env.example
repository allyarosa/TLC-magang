APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

# Untuk logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_ENABLED=true
LOG_EXCEPTION_HANDLER=default

# Untuk Vite (sebelumnya Mix)
VITE_APP_NAME="${APP_NAME}"

---
# Database
---

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Untuk database Redis (opsional)
# REDIS_CLIENT=
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

---
# Broadcasting
---

BROADCAST_DRIVER=log
# Pilihan: pusher, redis, log, null

---
# Caching
---

CACHE_DRIVER=file
# Pilihan: apc, array, database, file, memcached, redis, dynamodb, octet

---
# Session
---

SESSION_DRIVER=file
# Pilihan: file, cookie, database, apc, memcached, redis, dynamodb, array
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false

---
# Queue
---

QUEUE_CONNECTION=sync
# Pilihan: sync, database, beanstalkd, sqs, redis, null

---
# Mail
---

MAIL_MAILER=smtp
# Pilihan: smtp, ses, mailgun, postmark, sendmail, log, array, failover
MAIL_HOST=mailpit.local
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

---
# AWS S3 (Opsional, untuk penyimpanan cloud)
---

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

---
# Pusher (Opsional, untuk real-time events)
---

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=mt1

# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

---
# Sanctum (Untuk API authentication)
---

SANCTUM_STATEFUL_DOMAINS=